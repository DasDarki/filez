# Filez server configuration. Copy to .env and adjust. All values are optional.

# Port to listen on.
PORT=8080

# Whether the instance is publicly usable without an access key.
# true  = anyone can upload and download
# false = an access key (created in /admin) is required to upload
PUBLIC=true

# On a private instance (PUBLIC=false), still serve download (/d) and preview
# (/p) links WITHOUT an access key, so shared links work for recipients.
# Password-protected files remain gated by their password. Set to false to
# require the access key for links too (fully locked-down instance).
PUBLIC_LINKS=true

# Enables the /admin area and access-key management. Leave empty to disable
# /admin entirely (it then returns 404). The admin username is always "admin".
ADMIN_PASSWORD=

# Where metadata (SQLite, WAL mode) and file bytes are stored.
DATA_DIR=./data

# Maximum upload size. Accepts units: B, KB, MB, GB, KiB, MiB, GiB.
MAX_UPLOAD_SIZE=1GiB

# In-memory hot-file cache budget (ristretto). Accepts the same units.
CACHE_SIZE=256MiB

# Default upload mode advertised to clients and used by the web UI.
# Either "permanent" or "temp:<duration>" (e.g. temp:1d, temp:2d20m).
DEFAULT_UPLOAD=permanent

# Optional. Public base URL used to build returned links. If empty, it is
# derived from the incoming request (scheme + host). Usually not needed when
# TRUST_PROXY is on; set it to force a fixed URL, e.g. https://files.example.com
BASE_URL=

# Trust X-Forwarded-Proto / X-Forwarded-Host from loopback/private proxies so
# links are correct behind a reverse proxy (Coolify, Traefik, nginx). Safe to
# leave on: directly-exposed instances see public client IPs, which aren't
# trusted. Set to false only if you terminate TLS directly on the app.
TRUST_PROXY=true
